{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/analyze-tone", "dest": "/api/analyze-tone.js" },
    { "src": "/translate", "dest": "/api/translate.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
